FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
COPY apps/web/package*.json ./apps/web/

RUN npm ci

COPY . .

RUN npm run build --prefix apps/web

FROM nginx:alpine

COPY --from=build /app/dist/apps/web /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
